{
  "name": "sovereign-engine-os",
  "version": "3.0.0",
  "description": "Sovereign Engine OS",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/src/server/index.js",
    "dev": "node --loader ts-node/esm src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@supabase/supabase-js": "^2.43.0",
    "cors": "^2.8.5",
    "dodopayments": "^1.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "standardwebhooks": "^1.0.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^1.6.0",
    "supertest": "^7.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
